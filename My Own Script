local function addOpenSideDesign(button)
    if not button or button:FindFirstChild("OpenSideDesignLeft") then return end

    local function makeSide(name, position, flip)
        local holder = Instance.new("Frame")
        holder.Name = name
        holder.Size = UDim2.fromOffset(22, 34)
        holder.Position = position
        holder.BackgroundTransparency = 1
        holder.BorderSizePixel = 0
        holder.ZIndex = math.max(1, button.ZIndex - 1)
        holder.Parent = button

        for i = 0, 1 do
            local slash = Instance.new("Frame")
            slash.Name = "NeonSlash" .. (i + 1)
            slash.Size = UDim2.fromOffset(7, 27)
            slash.Position = UDim2.fromOffset(i * 9 + (flip and 3 or 0), 4)
            slash.Rotation = flip and -25 or 25
            slash.BackgroundColor3 = Color3.fromRGB(35, 255, 115)
            slash.BackgroundTransparency = 0.05
            slash.BorderSizePixel = 0
            slash.ZIndex = holder.ZIndex
            slash.Parent = holder
            corner(slash, 2)
        end
