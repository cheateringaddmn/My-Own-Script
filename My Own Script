	local function FindVehicle()
		local Character = Player.Character
		if not Character then return end
		local Humanoid = Character:FindFirstChildOfClass("Humanoid")
		if not Humanoid then return end
		local CurrentSeat = Humanoid.SeatPart
		if not CurrentSeat then return end
		if not CurrentSeat:IsA("VehicleSeat") and not CurrentSeat:IsA("Seat") then
			return
		end
		local CurrentVehicle = CurrentSeat:FindFirstAncestorOfClass("Model")
		if not CurrentVehicle then return end
		local CurrentPrimary = CurrentVehicle.PrimaryPart
		if not CurrentPrimary then
			CurrentPrimary = CurrentVehicle:FindFirstChildWhichIsA("BasePart")
		end
		if not CurrentPrimary then return end
		return CurrentVehicle, CurrentSeat, CurrentPrimary
	end

	local function StopNoclip()
		if NoclipConnection then
			NoclipConnection:Disconnect()
			NoclipConnection = nil
		end
		-- Restore each part to its original collision setting instead of forcing true.
		for part, wasCollidable in pairs(OriginalCanCollide) do
			if part and part.Parent then
				part.CanCollide = wasCollidable
			end
			OriginalCanCollide[part] = nil
		end
	end

	local function StartNoclip()
		if NoclipConnection then NoclipConnection:Disconnect() end
		NoclipConnection = RunService.Stepped:Connect(function()
			if not Flying or not Vehicle or not Vehicle.Parent then return end
			for _, Object in ipairs(Vehicle:GetDescendants()) do
				if Object:IsA("BasePart") then
					if OriginalCanCollide[Object] == nil then
						OriginalCanCollide[Object] = Object.CanCollide
					end
					Object.CanCollide = false
				end
			end
		end)
	end

