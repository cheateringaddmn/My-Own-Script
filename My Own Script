-- Keep gradients on the button BACKGROUND only. A UIGradient attached directly
-- to a TextButton also gradients its text, which made OPEN labels nearly black.
-- This preserves each button's click handler, size, position, and callback.
local openButtonsForBackground = {open, open2, openFly, openFlyVehicle, openFlyToPlayer, openCoord, openPlayer, openEmotesR6}
for _, button in ipairs(openButtonsForBackground) do
    button.TextColor3 = Color3.fromRGB(245, 255, 250)
    button.TextTransparency = 0
    button.TextStrokeColor3 = Color3.fromRGB(0, 70, 24)
    button.TextStrokeTransparency = 1
    button.BackgroundTransparency = 1

    local gradient = button:FindFirstChildOfClass("UIGradient")
    -- IMPORTANT: keep the gradient frame as a SIBLING behind the TextButton.
    -- Parenting it inside the TextButton can layer it over the label on some
    -- Roblox UI hierarchies, making the OPEN text disappear entirely.
    local background = Instance.new("Frame")
    background.Name = button.Name .. "GradientBackground"
    background.Size = button.Size
    background.Position = button.Position
    background.AnchorPoint = button.AnchorPoint
    background.BackgroundColor3 = Color3.fromRGB(0, 88, 31)
    background.BorderSizePixel = 0
    background.ZIndex = math.max(1, button.ZIndex - 1)
    background.Parent = button.Parent
    corner(background, 4)

    if gradient then
        gradient.Parent = background
    else
        local fallbackGradient = Instance.new("UIGradient")
        fallbackGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 180, 58)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 91, 34)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 44, 22))
        })
        fallbackGradient.Rotation = 90
        fallbackGradient.Parent = background
    end
end

