local noclipEnabled=false
local noclipConnection
local noclipSavedCanCollide={}

local function loadNoClipCharacter()
	return Player.Character or Player.CharacterAdded:Wait()
end

local function setNoclip(enabled)
	noclipEnabled=enabled

	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection=nil
	end

	if enabled then
		table.clear(noclipSavedCanCollide)

		local character=loadNoClipCharacter()

		for _,part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				noclipSavedCanCollide[part]=part.CanCollide
				part.CanCollide=false
			end
		end

		noclipConnection=RunService.Stepped:Connect(function()
			if not noclipEnabled then return end

			local characterNow=Player.Character
			if not characterNow then return end

			for _,part in ipairs(characterNow:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide=false
				end
			end
		end)

		if noclipToggle then
			noclipToggle.Text="NoClip ON"
			noclipToggle.BackgroundColor3=Color3.fromRGB(80,255,100)
		end
	else
		for part,original in pairs(noclipSavedCanCollide) do
			if part and part.Parent then
				part.CanCollide=original
			end
		end

		table.clear(noclipSavedCanCollide)

		if noclipToggle then
			noclipToggle.Text="NoClip OFF"
			noclipToggle.BackgroundColor3=Color3.fromRGB(220,50,50)
		end
	end
end

