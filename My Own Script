		Vehicle, Seat, Primary = NewVehicle, NewSeat, NewPrimary
		Flying = true
		StartNoclip()

		BodyVelocity = Instance.new("BodyVelocity")
		BodyVelocity.Name = "FlyVehicleVelocity"
		BodyVelocity.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
		BodyVelocity.P = 50000
		BodyVelocity.Velocity = Vector3.zero
		BodyVelocity.Parent = Primary

		BodyGyro = Instance.new("BodyGyro")
		BodyGyro.Name = "FlyVehicleGyro"
		BodyGyro.MaxTorque = Vector3.new(math.huge,math.huge,math.huge)
		BodyGyro.P = 50000
		BodyGyro.D = 1000
		BodyGyro.CFrame = Primary.CFrame
		BodyGyro.Parent = Primary

		FlyButton.Text = "FLY ON"
		FlyButton.BackgroundColor3 = Color3.fromRGB(0,220,40)

		FlyConnection = RunService.RenderStepped:Connect(function()
			if not Flying or GuiClosed then return end
			if not Vehicle or not Vehicle.Parent or not Primary or not Primary.Parent then
				StopFly()
				return
			end
			local Character = Player.Character
			local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
			if not Humanoid or Humanoid.SeatPart ~= Seat then
				StopFly()
				return
			end
			local Camera = Workspace.CurrentCamera
			if not Camera then return end

			local forward = Camera.CFrame.LookVector
			local right = Camera.CFrame.RightVector
			local throttle, steer = 0, 0
			if Seat:IsA("VehicleSeat") then
				throttle = Seat.ThrottleFloat
				steer = Seat.SteerFloat
			else
				local move = Humanoid.MoveDirection
				local flatForward = Vector3.new(forward.X, 0, forward.Z)
				local flatRight = Vector3.new(right.X, 0, right.Z)
				if flatForward.Magnitude > 0.001 then flatForward = flatForward.Unit end
				if flatRight.Magnitude > 0.001 then flatRight = flatRight.Unit end
				if move.Magnitude > 0.01 then
					if flatForward.Magnitude > 0.001 then
						throttle = math.clamp(move:Dot(flatForward), -1, 1)
					end
					if flatRight.Magnitude > 0.001 then
						steer = math.clamp(move:Dot(flatRight), -1, 1)
					end
				end
			end

			local movement = forward * throttle + right * steer
			if movement.Magnitude > 0.01 then
				BodyVelocity.Velocity = movement.Unit * GetFlySpeed()
			else
				BodyVelocity.Velocity = Vector3.zero
			end

			-- Use default look-at up handling to avoid degenerate camera up vectors.
			BodyGyro.CFrame = CFrame.lookAt(
				Primary.Position,
				Primary.Position + forward
			)
		end)
	end

	FlyButton.Activated:Connect(function()
		if GuiClosed then return end
		if Flying then StopFly() else StartFly() end
	end)

	ApplyButton.Activated:Connect(function()
		if GuiClosed then return end
		local Level = tonumber(SpeedBox.Text)
		if not Level then
			SpeedBox.Text = tostring(SpeedLevel)
			return
		end
		SpeedLevel = math.max(math.floor(Level),1)
		SpeedBox.Text = tostring(SpeedLevel)
	end)

	MinimizeButton.Activated:Connect(function()
		if GuiClosed then return end
		Minimized = not Minimized
		if Minimized then
			MainFrame.Size = UDim2.new(0,220,0,48)
			SpeedBox.Visible = false
			FlyButton.Visible = false
			ApplyButton.Visible = false
			MinimizeButton.Text = "+"
		else
			MainFrame.Size = UDim2.new(0,220,0,132)
			SpeedBox.Visible = true
			FlyButton.Visible = true
			ApplyButton.Visible = true
			MinimizeButton.Text = ""
		end
	end)

	local function CloseAll()
		if GuiClosed then return end
		GuiClosed = true
		StopFly()
		if InputChangedConnection then InputChangedConnection:Disconnect(); InputChangedConnection = nil end
		if InputEndedConnection then InputEndedConnection:Disconnect(); InputEndedConnection = nil end
		if CharacterAddedConnection then CharacterAddedConnection:Disconnect(); CharacterAddedConnection = nil end
		if ScreenGui then ScreenGui:Destroy() end
		_G.CheateringaddmnFlyVehicleController = nil
	end

	CloseButton.Activated:Connect(CloseAll)

	local Dragging, DragInput, DragStart, StartPosition = false, nil, nil, nil
	MainFrame.InputBegan:Connect(function(Input)
		if GuiClosed then return end
		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then
			Dragging = true
			DragStart = Input.Position
			StartPosition = MainFrame.Position
		end
	end)
	MainFrame.InputChanged:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseMovement
			or Input.UserInputType == Enum.UserInputType.Touch then
			DragInput = Input
		end
	end)
	InputChangedConnection = UserInputService.InputChanged:Connect(function(Input)
		if not Dragging or GuiClosed or not DragInput then return end
		if Input.UserInputType == Enum.UserInputType.MouseMovement
			or Input.UserInputType == Enum.UserInputType.Touch then
				local Delta = Input.Position - DragStart
				MainFrame.Position = UDim2.new(
					StartPosition.X.Scale, StartPosition.X.Offset + Delta.X,
					StartPosition.Y.Scale, StartPosition.Y.Offset + Delta.Y
				)
		end
	end)
	InputEndedConnection = UserInputService.InputEnded:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then
			Dragging = false
			DragInput = nil
		end
	end)

	CharacterAddedConnection = Player.CharacterAdded:Connect(function()
		if not GuiClosed then StopFly() end
	end)

	_G.CheateringaddmnFlyVehicleController = {
		Gui = ScreenGui,
		Restore = function()
			if ScreenGui and ScreenGui.Parent then
				MainFrame.Visible = true
			end
		end,
		Close = CloseAll
	}
	MainFrame.Visible = true
end



