local function createTool()
	local backpack=Player:WaitForChild("Backpack")

	if tool and tool.Parent then
		tool.Parent=backpack
		return
	end

	local existing=backpack:FindFirstChild("BC Tap To Teleport")

	if existing then
		existing:Destroy()
	end

	local character=Player.Character

	if character then
		local old=character:FindFirstChild("BC Tap To Teleport")

		if old then
			old:Destroy()
		end
	end

	tool=Instance.new("Tool")
	tool.Name="BC Tap To Teleport"
	tool.RequiresHandle=false
	tool.CanBeDropped=false
	tool.ManualActivationOnly=false
	tool.ToolTip="Tap an object to teleport"
	tool.Parent=backpack

	local mouse=Player:GetMouse()
	local lastTouchPosition=nil

	teleportTouchConnection=UIS.TouchStarted:Connect(function(input,gameProcessed)
		if gameProcessed then
			return
		end

		if tool and tool.Parent==Player.Character and input then
			lastTouchPosition=input.Position
		end
	end)

	tool.Activated:Connect(function()
		if not tool or tool.Parent~=Player.Character then
			return
		end

		local targetPosition=nil

		if lastTouchPosition then
			local camera=Workspace.CurrentCamera

			if camera then
				local ray=camera:ViewportPointToRay(
					lastTouchPosition.X,
					lastTouchPosition.Y
				)

				local params=RaycastParams.new()
				params.FilterType=Enum.RaycastFilterType.Exclude
				params.FilterDescendantsInstances={Player.Character}

				local result=Workspace:Raycast(
					ray.Origin,
					ray.Direction*1000,
					params
				)

				if result then
					targetPosition=result.Position
				end
			end
		end

		if not targetPosition and mouse then
			local hit=mouse.Hit

			if hit then
				targetPosition=hit.Position
			end
		end

		if targetPosition then
			teleportToPosition(targetPosition)
		end

		lastTouchPosition=nil
	end)

	teleportCharacterConnection=Player.CharacterAdded:Connect(function(newCharacter)
		task.wait(.25)

		if tool and tool.Parent then
			tool.Parent=Player:WaitForChild("Backpack")
		end
	end)
end

