	local function updateESP()
		for p,d in pairs(espObjects) do
			if not p.Parent then
				clearESP(p)
				continue
			end

			local c=p.Character
			local root=c and c:FindFirstChild("HumanoidRootPart")

			if not espOn or not root then
				d.Box.Visible=false
				d.Highlight.Enabled=false
				d.Billboard.Enabled=false
			else
				d.Box.Color3=espColor
				d.Highlight.FillColor=espColor
				d.Highlight.OutlineColor=espColor
				d.Label.TextColor3=espColor

				if espMode=="Box" then
					d.Box.Visible=true
					d.Highlight.Enabled=false
				else
					d.Box.Visible=false
					d.Highlight.Enabled=true
				end

				local text=""

				if espNameEnabled then
					text=p.Name
				end

				if espDistanceEnabled then
					local my=Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")

					if my then
						local dist=math.floor((my.Position-root.Position).Magnitude)

						if text~="" then
							text=text.."\n"
						end

						text=text..dist.." studs"
					end
				end

				d.Label.Text=text
				d.Billboard.Enabled=espNameEnabled or espDistanceEnabled
			end
		end
	end

